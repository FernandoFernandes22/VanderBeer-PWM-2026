<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:VanderBeer.App.Models"
 xmlns:viewModels="clr-namespace:VanderBeer.App.ViewModels"
 x:Class="VanderBeer.App.MainPage" x:DataType="viewModels:MainViewModel"
 Shell.NavBarIsVisible="False" BackgroundColor="#F7F5EF" Title="VanderBeer">
 <ContentPage.Resources>
  <Style TargetType="Label"><Setter Property="TextColor" Value="#203B31"/><Setter Property="FontFamily" Value="OpenSansRegular"/></Style>
  <Style x:Key="Muted" TargetType="Label"><Setter Property="TextColor" Value="#69766F"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="12"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="#44564C"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="#FFFFFF"/><Setter Property="Stroke" Value="#E3E7DE"/><Setter Property="StrokeShape" Value="RoundRectangle 20"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="InputBox" TargetType="Border"><Setter Property="BackgroundColor" Value="#FAFBF8"/><Setter Property="Stroke" Value="#DDE3D9"/><Setter Property="StrokeShape" Value="RoundRectangle 10"/><Setter Property="Padding" Value="10,2"/></Style>
  <Style TargetType="Entry"><Setter Property="TextColor" Value="#203B31"/><Setter Property="PlaceholderColor" Value="#87928A"/><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="FontSize" Value="14"/><Setter Property="MinimumHeightRequest" Value="44"/></Style>
  <Style x:Key="ActionButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#244C3B"/><Setter Property="TextColor" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontFamily" Value="OpenSansSemibold"/><Setter Property="MinimumHeightRequest" Value="48"/><Setter Property="Padding" Value="18,12"/><Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="BackgroundColor" Value="#E1E6DD"/><Setter Property="TextColor" Value="#79867C"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter></Style>
  <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
  <Style x:Key="QuantityButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="BackgroundColor" Value="#EEF2E9"/><Setter Property="TextColor" Value="#244C3B"/><Setter Property="WidthRequest" Value="44"/><Setter Property="MinimumHeightRequest" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="20"/></Style>
 </ContentPage.Resources>
 <ScrollView>
 <VerticalStackLayout Padding="18,24" Spacing="22" MaximumWidthRequest="1000" HorizontalOptions="Fill">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
   <Border BackgroundColor="#244C3B" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="48" HeightRequest="48"><Label Text="VB" TextColor="#F3C779" FontSize="19" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
   <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1"><Label Text="VanderBeer" FontFamily="OpenSansSemibold" FontSize="24"/><Label Text="BEBIDAS · BONS MOMENTOS" FontSize="10" CharacterSpacing="2" TextColor="#728175"/></VerticalStackLayout>
  </Grid>
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="26" BackgroundColor="#244C3B">
   <VerticalStackLayout Spacing="12">
    <Label Text="SEU PRÓXIMO BOM MOMENTO" FontSize="10" CharacterSpacing="2" TextColor="#E9BE72"/>
    <Label Text="A sua bebida favorita.&#10;O seu jeito de celebrar." FontFamily="OpenSansSemibold" FontSize="30" TextColor="#FFFFFF" LineHeight="1.1"/>
    <Label Text="Cervejas, refrigerantes e águas para acompanhar os seus encontros." TextColor="#D1DDD3" FontSize="14" MaximumWidthRequest="560" HorizontalOptions="Start"/>
    <BoxView HeightRequest="1" BackgroundColor="#54705F" Margin="0,5"/>
    <Label Text="01  Cadastro    /    02  Escolha    /    03  Pedido" FontSize="12" TextColor="#F3C779"/>
   </VerticalStackLayout>
  </Border>
  <Border BackgroundColor="#EDF2E8" Stroke="#DDE5D7" StrokeShape="RoundRectangle 12" Padding="14,12">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" Color="#244C3B" WidthRequest="22"/><Label Grid.Column="1" Text="{Binding Mensagem}" FontSize="13" VerticalOptions="Center" LineBreakMode="WordWrap"/></Grid>
  </Border>
  <VerticalStackLayout IsVisible="{Binding CadastroPendente}" Spacing="16">
   <Label Text="Vamos começar?" FontSize="25" FontFamily="OpenSansSemibold"/>
   <Label Text="Preencha seu cadastro. Depois, é só escolher suas bebidas." Style="{StaticResource Muted}"/>
   <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="18">
     <Label Text="01   Seus dados" FontSize="18" FontFamily="OpenSansSemibold"/>
     <Label Text="Todos os campos são obrigatórios." Style="{StaticResource Muted}"/>
     <VerticalStackLayout Spacing="5"><Label Text="Nome ou razão social" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Nome}" Placeholder="Como podemos chamar você?" Keyboard="Default" /></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="5"><Label Text="CPF ou CNPJ" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Cpf}" Placeholder="Informe seu documento" Keyboard="Numeric" /></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="5"><Label Text="E-mail" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Email}" Placeholder="voce@exemplo.com" Keyboard="Email" /></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="5"><Label Text="Telefone" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Telefone}" Placeholder="DDD + número" Keyboard="Telephone" /></Border></VerticalStackLayout>
    </VerticalStackLayout>
   </Border>
   <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="18">
     <Label Text="02   Onde vamos entregar?" FontSize="18" FontFamily="OpenSansSemibold"/>
     <Label Text="Informe o CEP para preencher o endereço. Todos os campos continuam editáveis." Style="{StaticResource Muted}"/>
     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <ActivityIndicator IsRunning="{Binding BuscandoCep}" IsVisible="{Binding BuscandoCep}" Color="#244C3B" WidthRequest="20"/>
      <Label Grid.Column="1" Text="{Binding MensagemCep}" Style="{StaticResource Muted}" VerticalOptions="Center"/>
      <Button Grid.Column="2" Text="Buscar CEP" Command="{Binding BuscarCepCommand}" BackgroundColor="#E9EEDF" TextColor="#244C3B"/>
     </Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
      <VerticalStackLayout Spacing="5"><Label Text="CEP" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Cep}" Placeholder="00000000" Keyboard="Numeric" /></Border></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1"><VerticalStackLayout Spacing="5"><Label Text="Número" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Numero}" Placeholder="Ex.: 125 ou S/N" Keyboard="Default" /></Border></VerticalStackLayout></VerticalStackLayout>
     </Grid>
     <VerticalStackLayout Spacing="5"><Label Text="Rua / avenida" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Endereco}" Placeholder="Nome do logradouro" Keyboard="Default" /></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="5"><Label Text="Bairro" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Bairro}" Placeholder="Seu bairro" Keyboard="Default" /></Border></VerticalStackLayout>
     <Grid ColumnDefinitions="*,90" ColumnSpacing="14">
      <VerticalStackLayout Spacing="5"><Label Text="Cidade" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Cidade}" Placeholder="Sua cidade" Keyboard="Default" /></Border></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1"><VerticalStackLayout Spacing="5"><Label Text="UF" Style="{StaticResource FieldLabel}" /><Border Style="{StaticResource InputBox}"><Entry Text="{Binding Uf}" Placeholder="UF" Keyboard="Default" MaxLength="2"/></Border></VerticalStackLayout></VerticalStackLayout>
     </Grid>
     <Button Text="Confirmar cadastro e ver bebidas  →" Command="{Binding CadastrarCommand}" Margin="0,6,0,0"/>
     <Label Text="Seu cadastro será confirmado antes de abrir o catálogo." Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
   </Border>
  </VerticalStackLayout>
  <VerticalStackLayout IsVisible="{Binding CatalogoLiberado}" Spacing="20">
   <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
    <Button Text="Loja" Command="{Binding AbrirLojaCommand}" />
    <Button Grid.Column="1" Text="Meus pedidos" Command="{Binding AbrirPedidosCommand}" />
   </Grid>
   <VerticalStackLayout IsVisible="{Binding MostrarLoja}" Spacing="20">
   <Border Style="{StaticResource Card}" Padding="16"><VerticalStackLayout Spacing="5"><Label Text="CADASTRO CONFIRMADO" FontSize="10" CharacterSpacing="1.5" TextColor="#547F48"/><Label Text="{Binding Identificacao}" FontSize="12" LineBreakMode="WordWrap"/></VerticalStackLayout></Border>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="4"><Label Text="Escolha seu próximo brinde" FontSize="24" FontFamily="OpenSansSemibold"/><Label Text="Explore os produtos e monte seu pedido." Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Atualizar" Command="{Binding CarregarCommand}" BackgroundColor="#E9EEDF" TextColor="#244C3B" VerticalOptions="Center"/></Grid>
   <VerticalStackLayout BindableLayout.ItemsSource="{Binding Produtos}" Spacing="12">
    <BindableLayout.EmptyView><Label Text="Nenhuma bebida por aqui ainda. Toque em Atualizar para tentar novamente." Style="{StaticResource Muted}" Margin="0,16"/></BindableLayout.EmptyView>
    <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ProdutoModel">
     <Border Style="{StaticResource Card}" Padding="18">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
       <Border BackgroundColor="#F6EDD9" StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="80" VerticalOptions="Start"><Label Text="VB" FontSize="22" FontAttributes="Bold" TextColor="#A4772F" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
       <VerticalStackLayout Grid.Column="1" Spacing="7">
        <Label Text="{Binding Categoria}" FontSize="10" CharacterSpacing="1.5" TextColor="#947038"/>
        <Label Text="{Binding Nome}" FontSize="18" FontFamily="OpenSansSemibold"/>
        <Label Text="{Binding Descricao}" Style="{StaticResource Muted}"/>
        <Label Text="{Binding Estoque, StringFormat='{0} unidades disponíveis'}" FontSize="11" TextColor="#788576"/>
        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
         <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}" FontSize="23" FontFamily="OpenSansSemibold" Margin="0,8,12,8"/>
         <Button Text="+  Adicionar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdicionarCommand}" CommandParameter="{Binding .}" SemanticProperties.Hint="Adicionar este produto ao carrinho"/>
        </FlexLayout>
       </VerticalStackLayout>
      </Grid>
     </Border>
    </DataTemplate></BindableLayout.ItemTemplate>
   </VerticalStackLayout>
   <Border Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="18">
     <Label Text="Seu carrinho" FontSize="23" FontFamily="OpenSansSemibold"/>
     <Label Text="Revise as quantidades antes de confirmar." Style="{StaticResource Muted}"/>
     <VerticalStackLayout BindableLayout.ItemsSource="{Binding Carrinho}" Spacing="14">
      <BindableLayout.EmptyView><Border BackgroundColor="#F6F7F1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="20"><VerticalStackLayout Spacing="6"><Label Text="Seu próximo brinde começa aqui." FontAttributes="Bold"/><Label Text="Adicione uma bebida do catálogo para montar seu pedido." Style="{StaticResource Muted}"/></VerticalStackLayout></Border></BindableLayout.EmptyView>
      <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ItemCarrinho">
       <VerticalStackLayout Spacing="10">
        <Label Text="{Binding Produto.Nome}" FontFamily="OpenSansSemibold" FontSize="15"/>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
         <Button Text="−" Style="{StaticResource QuantityButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DiminuirCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Diminuir quantidade"/>
         <Label Grid.Column="1" Text="{Binding Quantidade}" WidthRequest="28" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
         <Button Grid.Column="2" Text="+" Style="{StaticResource QuantityButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AumentarCommand}" CommandParameter="{Binding .}" SemanticProperties.Description="Aumentar quantidade"/>
         <Label Grid.Column="3" Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontAttributes="Bold"/>
        </Grid>
        <BoxView HeightRequest="1" BackgroundColor="#EBEEE5"/>
       </VerticalStackLayout>
      </DataTemplate></BindableLayout.ItemTemplate>
     </VerticalStackLayout>
     <Border BackgroundColor="#244C3B" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="18"><VerticalStackLayout Spacing="4"><Label Text="VALOR DOS PRODUTOS" FontSize="10" CharacterSpacing="1.5" TextColor="#C7D6C9"/><Label Text="{Binding TotalFormatado}" TextColor="White" FontSize="26" FontFamily="OpenSansSemibold"/></VerticalStackLayout></Border>
     <Label Text="Como deseja pagar?" FontSize="16" FontFamily="OpenSansSemibold"/>
     <Border Style="{StaticResource InputBox}"><Picker Title="Escolha uma forma de pagamento" ItemsSource="{Binding FormasPagamento}" SelectedItem="{Binding FormaPagamento}" TextColor="#203B31" TitleColor="#69766F" BackgroundColor="Transparent"/></Border>
     <Label Text="Pagamento demonstrativo: nenhuma cobrança será realizada. A entrega usará o endereço informado no cadastro." Style="{StaticResource Muted}"/>
     <Button Text="Confirmar pedido  →" Command="{Binding FinalizarCommand}" FontSize="16"/>
    </VerticalStackLayout>
   </Border>

   </VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding MostrarPedidos}" Spacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
     <VerticalStackLayout Spacing="4"><Label Text="Meus pedidos" FontSize="25" FontFamily="OpenSansSemibold"/><Label Text="Acompanhe suas compras e confira todos os detalhes." Style="{StaticResource Muted}"/></VerticalStackLayout>
     <Button Grid.Column="1" Text="Atualizar" Command="{Binding AtualizarPedidosCommand}" BackgroundColor="#E9EEDF" TextColor="#244C3B" />
    </Grid>
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pedidos}" Spacing="16">
     <BindableLayout.EmptyView><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Label Text="Sua primeira compra começa na loja." FontSize="18" FontAttributes="Bold"/><Label Text="Seus pedidos aparecerão aqui, com os produtos, valores e informações de entrega." Style="{StaticResource Muted}"/><Button Text="Explorar bebidas" Command="{Binding AbrirLojaCommand}"/></VerticalStackLayout></Border></BindableLayout.EmptyView>
     <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:PedidoModel">
      <Border Style="{StaticResource Card}">
       <VerticalStackLayout Spacing="14">
        <Label Text="{Binding CodigoExibicao}" FontSize="21" FontFamily="OpenSansSemibold"/>
        <Label Text="{Binding DataHora}" Style="{StaticResource Muted}"/>
        <Border BackgroundColor="#EDF2E8" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8" HorizontalOptions="Start"><Label Text="{Binding StatusExibicao}" TextColor="#244C3B" FontAttributes="Bold" FontSize="12"/></Border>
        <Label Text="{Binding CodigoPedido, StringFormat='Código completo: {0}'}" FontSize="11" TextColor="#69766F" LineBreakMode="CharacterWrap"/>
        <BoxView HeightRequest="1" BackgroundColor="#E3E7DE"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Itens}" Spacing="12">
         <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:ItemPedidoModel">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
           <VerticalStackLayout Spacing="4"><Label Text="{Binding Descricao}" FontAttributes="Bold"/><Label Text="{Binding ValorUnitario}" Style="{StaticResource Muted}"/></VerticalStackLayout>
           <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}" VerticalOptions="Center" FontAttributes="Bold"/>
          </Grid>
         </DataTemplate></BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <BoxView HeightRequest="1" BackgroundColor="#E3E7DE"/>
        <Label Text="{Binding Total, StringFormat='Total do pedido: R$ {0:F2}'}" FontSize="22" FontFamily="OpenSansSemibold"/>
        <Label Text="{Binding Pagamento}" Style="{StaticResource Muted}"/>
        <Label Text="ENDEREÇO DE ENTREGA" FontSize="10" CharacterSpacing="1.5" TextColor="#947038"/>
        <Label Text="{Binding EnderecoEntrega}" FontSize="13"/>
       </VerticalStackLayout>
      </Border>
     </DataTemplate></BindableLayout.ItemTemplate>
    </VerticalStackLayout>
   </VerticalStackLayout>
  </VerticalStackLayout>
  <BoxView HeightRequest="1" BackgroundColor="#E0E5DA" Margin="0,6"/>
  <Label Text="VanderBeer  ·  Bons momentos começam com boas escolhas." FontSize="11" TextColor="#7D897E" HorizontalTextAlignment="Center" Margin="0,0,0,16"/>
 </VerticalStackLayout>
 </ScrollView>
</ContentPage>
